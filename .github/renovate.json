{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:recommended",
    ":dependencyDashboard",
    "helpers:pinGitHubActionDigestsToSemver",
    "docker:pinDigests",
    ":configMigration",
    ":docker",
    ":separateMajorReleases",
    ":separateMultipleMinorReleases",
    ":separatePatchReleases",
    ":separatePatchReleases",
    "github>cryostatio/cryostat//.github/renovate/release-branch/lockdown",
    "github>cryostatio/cryostat//.github/renovate/release-branch/default(maven)",
    "github>cryostatio/cryostat//.github/renovate/release-branch/default(dockerfile)"
  ],
  "baseBranchPatterns": ["main", "/^cryostat-v.*/"],
  "reviewersFromCodeOwners": true,
  "labels": [
    "dependencies",
    "chore",
    "safe-to-test"
  ],
  "semanticCommits": "enabled",
  "major": {
    "dependencyDashboardApproval": true
  },
  "stopUpdatingLabel": "blocked",
  "customManagers": [
    {
      "customType": "regex",
      "description": "Track the VALIDATOR_VERSION pin that the config validator workflow passes to npx, so Renovate raises a PR to bump its own validator",
      "managerFilePatterns": ["/^\\.github/workflows/.+\\.ya?ml$/"],
      "matchStrings": [
        "VALIDATOR_VERSION:\\s*(?<currentValue>\\S+)"
      ],
      "depNameTemplate": "renovate",
      "datasourceTemplate": "npm"
    }
  ],
  "packageRules": [
    {
      "description": "Require approval for Quarkus major and minor version updates",
      "matchManagers": [
        "maven"
      ],
      "matchUpdateTypes": [
        "major",
        "minor"
      ],
      "dependencyDashboardApproval": true,
      "matchPackageNames": [
        "/^io\\.quarkus:/",
        "/^io\\.quarkus\\.platform:/"
      ]
    },
    {
      "description": "Create PR for Quarkus patch version updates",
      "matchManagers": [
        "maven"
      ],
      "matchUpdateTypes": [
        "patch",
        "pin",
        "pinDigest",
        "digest",
        "lockFileMaintenance",
        "rollback",
        "bump",
        "replacement"
      ],
      "prCreation": "immediate",
      "matchPackageNames": [
        "/^io\\.quarkus:/",
        "/^io\\.quarkus\\.platform:/"
      ]
    }
  ]
}

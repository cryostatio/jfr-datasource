FROM registry.access.redhat.com/ubi8/ubi-minimal@sha256:0990c03b74757479e30f381206efa1387ea2d5df037ede48c494f1acb041cf69
WORKDIR /work/
COPY target/*-runner /work/application
RUN chmod 775 /work
USER 1001
EXPOSE 8080
ENV LISTEN_HOST=${LISTEN_HOST:-0.0.0.0}
CMD ["./application", "-Dquarkus.http.host=${LISTEN_HOST}"]

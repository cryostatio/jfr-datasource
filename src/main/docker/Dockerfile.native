FROM registry.access.redhat.com/ubi8/ubi-minimal:8.6-994@sha256:33931dce809712888d1a8061bfa676963f517daca993984afed3251bc1fb5987
WORKDIR /work/
COPY target/*-runner /work/application
RUN chmod 775 /work
USER 1001
EXPOSE 8080
ENV LISTEN_HOST=${LISTEN_HOST:-0.0.0.0}
CMD ["./application", "-Dquarkus.http.host=${LISTEN_HOST}"]

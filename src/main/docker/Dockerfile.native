FROM registry.access.redhat.com/ubi8/ubi-minimal@sha256:cdbcb44a1bca90a0e70a6fd68abf9b8b43fea00d96e8c2de8ec2cba372273cdc
WORKDIR /work/
COPY target/*-runner /work/application
RUN chmod 775 /work
USER 1001
EXPOSE 8080
ENV LISTEN_HOST=${LISTEN_HOST:-0.0.0.0}
CMD ["./application", "-Dquarkus.http.host=${LISTEN_HOST}"]

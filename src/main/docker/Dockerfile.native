FROM registry.access.redhat.com/ubi8/ubi-minimal@sha256:b915e698d01cf0750b82c6ab54adc794870381271670fd7211b082f19f8564f7
WORKDIR /work/
COPY target/*-runner /work/application
RUN chmod 775 /work
USER 1001
EXPOSE 8080
ENV LISTEN_HOST=${LISTEN_HOST:-0.0.0.0}
CMD ["./application", "-Dquarkus.http.host=${LISTEN_HOST}"]
